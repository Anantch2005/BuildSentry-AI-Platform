    {
      "type": "stat",
      "title": "Healing Rate",
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "postgres",
        "uid": "buildsentry-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "WITH resolved AS ( SELECT DISTINCT incident_id, MAX(CASE WHEN event_type = 'REMEDIATION_SUCCEEDED' THEN 1 ELSE 0 END) AS healed, MAX(CASE WHEN event_type = 'AUTOHEAL_RESULT' THEN 1 ELSE 0 END) AS completed FROM audit_events WHERE $__timeFilter(created_at) GROUP BY incident_id ) SELECT COALESCE(ROUND(100.0 * SUM(healed) / NULLIF(SUM(completed), 0), 2), 0)::double precision AS value FROM resolved;"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#06b6d4"
          },
          "custom": {},
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "vertical",
        "wideLayout": true,
