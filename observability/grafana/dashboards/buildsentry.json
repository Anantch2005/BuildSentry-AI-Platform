    {
      "type": "table",
      "title": "Recent BuildSentry Incidents",
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "postgres",
        "uid": "buildsentry-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT i.created_at AS \"time\", i.incident_id AS \"Incident\", i.job_name AS \"Job\", i.build_number AS \"Failed Build\", i.status AS \"Status\", i.failure_category AS \"Category\", i.failure_action AS \"Classifier Action\", i.classifier_source AS \"Classifier Source\", i.confidence AS \"Confidence\", ra.action AS \"Remediation Action\", ra.success AS \"Remediation Success\", ra.retry_build_number AS \"Retry Build\", ra.verification_result AS \"Verification\" FROM incidents i LEFT JOIN LATERAL ( SELECT * FROM remediation_attempts x WHERE x.incident_id = i.id ORDER BY x.id DESC LIMIT 1 ) ra ON TRUE WHERE $__timeFilter(i.created_at) ORDER BY i.created_at DESC LIMIT 25;"
        }
      ],
      "id": 20,
      "collapsed": false,
      "transparent": true,
      "options": {
        "showHeader": true,
        "cellHeight": "md",
        "footer": {
          "show": false
        },
        "sortBy": []
      },
      "description": "Use this table to investigate individual incidents; confirm recovery against the Jenkins build result."
    },
    {
      "type": "table",
      "title": "AI Output \u2014 Diagnosis & Reasoning",
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "postgres",
        "uid": "buildsentry-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT i.created_at AS \"time\", i.incident_id AS \"Incident\", i.job_name AS \"Job\", i.build_number AS \"Failed Build\", i.failure_category AS \"Final Category\", i.classifier_source AS \"Decision Source\", i.ai_confidence AS \"AI Confidence\", i.ai_root_cause AS \"AI Root Cause\", i.ai_reasoning AS \"AI Reasoning\" FROM incidents i WHERE i.ai_root_cause IS NOT NULL AND $__timeFilter(i.created_at) ORDER BY i.created_at DESC LIMIT 20;"
        }
      ],
      "id": 21,
      "collapsed": false,
      "transparent": true,
      "options": {
        "showHeader": true,
        "cellHeight": "md",
        "footer": {
          "show": false
        },
