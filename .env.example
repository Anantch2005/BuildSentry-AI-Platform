# Example .env file for Autoheal Platform
# Update this file with your own values and rename it to .env before running the application.
# =========================================================
# Jenkins
# =========================================================

JENKINS_URL=http://host.docker.internal:8080
JENKINS_USERNAME=admin
JENKINS_API_TOKEN=replace-me

# Jenkins webhook secret
WEBHOOK_SECRET=replace-with-a-long-random-token

# =========================================================
# PostgreSQL
# =========================================================

POSTGRES_DB=autoheal
POSTGRES_USER=autoheal
POSTGRES_PASSWORD=replace-with-a-long-random-password

DATABASE_URL=postgresql+psycopg2://autoheal:${POSTGRES_PASSWORD}@postgres:5432/autoheal

# =========================================================
# AI / Ollama
# =========================================================

AI_ENABLED=true
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b
AI_MAX_LOG_CHARS=12000

# =========================================================
# OpenTelemetry
# =========================================================

OTEL_ENDPOINT=http://otel-collector:4318
OTEL_ENABLED=true

# =========================================================
# Alertmanager
# =========================================================

ALERTMANAGER_SECRET=replace-with-a-long-random-alertmanager-token
# Grafana (use a unique password; do not keep the example value)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-password

# Optional: Slack Incoming Webhook URL for human-facing alerts. Leave blank to disable.
SLACK_WEBHOOK_URL=